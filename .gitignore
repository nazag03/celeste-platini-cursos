# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local (SQLite de desarrollo)
/prisma/dev.db
/prisma/dev.db-journal

# exportaciones de datos (incluyen datos de clientes y hashes de contraseñas)
/.data-export

# archivos subidos localmente (en producción deben ir a un almacenamiento de
# objetos como Vercel Blob o S3, no al filesystem del servidor)
/public/uploads
/private
