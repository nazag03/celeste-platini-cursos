generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          String    @default("CUSTOMER")
  phone         String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  enrollments  Enrollment[]
  purchases    Purchase[]
  downloadLogs DownloadLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  kind        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  shortDescription String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  productType String
  availabilityStatus String @default("POR_ENCARGO")

  price           Float?
  priceNote       String?
  requiresQuote   Boolean @default(false)

  stockQuantity   Int?
  allowPickup     Boolean @default(true)
  allowShipping   Boolean @default(false)
  shippingArea    String?
  shippingCost    Float?
  shippingNotes   String?

  prepTimeDays       Int?
  minAdvanceDays      Int?
  requiresDeposit     Boolean @default(false)
  unavailableDates    String?
  deliveryDaysNote    String?

  servings        String?
  customizable    Boolean @default(false)

  isFeatured      Boolean @default(false)
  isPublished     Boolean @default(true)
  isArchived      Boolean @default(false)
  isDemo          Boolean @default(false)

  whatsappMessageTemplate String?
  customerInstructions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           ProductImage[]
  variantGroups    VariantGroup[]
  orderRequestItems CustomOrderRequest[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isDemo    Boolean @default(false)
}

model VariantGroup {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  required  Boolean @default(false)
  sortOrder Int     @default(0)

  options VariantOption[]
}

model VariantOption {
  id             String       @id @default(cuid())
  variantGroupId String
  variantGroup   VariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
  label          String
  priceModifier  Float        @default(0)
  sortOrder      Int          @default(0)
}

model CustomOrderRequest {
  id          String   @id @default(cuid())
  orderNumber String   @unique

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?

  eventDate       DateTime?
  servingsOrQty   String?
  flavorFilling   String?
  theme           String?
  colors          String?
  dedication      String?
  deliveryMethod  String?
  estimatedBudget Float?
  notes           String?
  referenceImageUrl String?

  status       String   @default("RECIBIDO")
  quotedPrice  Float?
  adminNotes   String?

  dedupeKey  String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  statusHistory OrderStatusEvent[]
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     CustomOrderRequest @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model EventBudgetRequest {
  id          String   @id @default(cuid())
  requestNumber String @unique

  customerName  String
  customerPhone String
  customerEmail String?

  eventType       String
  eventDate       DateTime?
  guestCount      Int?
  location        String?
  productsOfInterest String?
  estimatedBudget Float?
  notes           String?

  status      String   @default("RECIBIDO")
  quotedPrice Float?
  adminNotes  String?

  dedupeKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  summary     String?
  description String

  courseType String
  level      String?
  modality   String?
  durationNote String?

  price         Float?
  requiresQuote Boolean @default(false)

  coverImageUrl String?
  coverImages Json @default("[]")
  trailerVideoUrl String?

  materialLinks Json @default("[]")
  driveUrl String?

  liveDate         DateTime?
  liveAccessLink   String?
  liveInstructions String?

  includesMaterial String?
  requirements     String?

  isFeatured  Boolean @default(true)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     CourseModule[]
  enrollments Enrollment[]
  faqs        CourseFAQ[]
}

model CourseModule {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int    @default(0)

  lessons Lesson[]
}

model Lesson {
  id             String       @id @default(cuid())
  moduleId       String
  module         CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  videoUrl       String?
  durationMinutes Int?
  materialUrl    String?
  sortOrder      Int          @default(0)
  isFreePreview  Boolean      @default(false)
}

model CourseFAQ {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question String
  answer   String
  sortOrder Int   @default(0)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  status    String   @default("PENDIENTE_PAGO")
  progress  String?
  grantedAt DateTime?
  grantedByAdmin String?
  mpOrderId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessLinks AccessLink[]

  @@unique([userId, courseId])
}

model DigitalProduct {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String
  includesNote String?
  level       String?
  fileFormat  String?
  price       Float?

  coverImageUrl String?
  sampleImages  String?

  filePath    String?
  driveUrl    String?

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  digitalProductId String
  digitalProduct   DigitalProduct @relation(fields: [digitalProductId], references: [id])
  status           String   @default("PENDIENTE_PAGO")
  grantedAt        DateTime?
  grantedByAdmin   String?
  mpOrderId        String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  downloadTokens DownloadToken[]
  accessLinks    AccessLink[]

  @@unique([userId, digitalProductId])
}

model AccessLink {
  id           String      @id @default(cuid())
  token        String      @unique
  mpOrderId    String?     @unique
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  purchaseId   String?
  purchase     Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

model DownloadToken {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  usedCount  Int      @default(0)
  maxUses    Int      @default(5)
  createdAt  DateTime @default(now())

  logs DownloadLog[]
}

model DownloadLog {
  id              String        @id @default(cuid())
  downloadTokenId String
  downloadToken   DownloadToken @relation(fields: [downloadTokenId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  ipAddress       String?
  createdAt       DateTime      @default(now())
}

model SiteSettings {
  id    String @id @default("default")

  brandName        String  @default("Celeste Platini Pastelería")
  whatsappNumber   String?
  instagramUrl     String? @default("https://www.instagram.com/celesteplatinipasteleria/")
  contactEmail     String?
  location         String? @default("San Francisco, Córdoba")
  businessHours    String?

  announcementText    String?
  announcementIsActive Boolean @default(false)

  deliveryPickupEnabled  Boolean @default(true)
  deliveryShippingEnabled Boolean @default(false)
  paymentMethodsNote     String?

  heroImageUrl   String?
  heroTitle      String?
  heroSubtitle   String?

  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  customerName String
  content     String
  rating      Int?
  isVerified  Boolean  @default(false)
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String
  section   String  @default("general")
  sortOrder Int     @default(0)
  isPublished Boolean @default(true)
}

model GalleryImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  category  String?
  sortOrder Int     @default(0)
  isDemo    Boolean @default(false)
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  needsReview Boolean @default(true)
  updatedAt DateTime @updatedAt
}
